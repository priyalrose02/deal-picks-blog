<style>
  :root{
    --void:#0a0c12;
    --panel:#12161f;
    --panel-border:#1f2733;
    --cyan:#3fe0d0;
    --amber:#ff9b45;
    --text:#edeff3;
    --muted:#8b93a7;
    --radius:14px;
  }

  *{ box-sizing:border-box; }
  html{ scroll-behavior:smooth; }

  body{
    margin:0;
    background:var(--void);
    color:var(--text);
    font-family:'Inter', sans-serif;
    line-height:1.6;
    overflow-x:hidden;
    position:relative;
  }

  @media (prefers-reduced-motion: reduce){
    *, *::before, *::after{
      animation-duration:0.001ms !important;
      animation-iteration-count:1 !important;
      transition-duration:0.001ms !important;
      scroll-behavior:auto !important;
    }
  }

  /* ambient background: drifting grid + glows */
  .bg-grid{
    position:fixed; inset:0; z-index:0; pointer-events:none;
    background-image:
      linear-gradient(rgba(63,224,208,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(63,224,208,0.05) 1px, transparent 1px);
    background-size:48px 48px;
    animation:drift 26s linear infinite;
    mask-image:radial-gradient(ellipse 80% 60% at 50% 20%, black 40%, transparent 90%);
  }
  @keyframes drift{
    from{ background-position:0 0, 0 0; }
    to{ background-position:48px 96px, 48px 96px; }
  }
  .bg-glow{
    position:fixed; z-index:0; pointer-events:none; border-radius:50%;
    filter:blur(90px); opacity:0.28;
  }
  .bg-glow.cyan{ width:520px; height:520px; top:-120px; left:-100px; background:var(--cyan); animation:float1 18s ease-in-out infinite; }
  .bg-glow.amber{ width:460px; height:460px; bottom:-140px; right:-100px; background:var(--amber); animation:float2 22s ease-in-out infinite; }
  @keyframes float1{ 0%,100%{ transform:translate(0,0); } 50%{ transform:translate(40px,60px); } }
  @keyframes float2{ 0%,100%{ transform:translate(0,0); } 50%{ transform:translate(-30px,-50px); } }

  .wrap{ position:relative; z-index:1; max-width:920px; margin:0 auto; padding:0 24px; }

  /* hero */
  header.hero{ padding:96px 0 64px; text-align:left; }
  .eyebrow{
    font-family:'IBM Plex Mono', monospace;
    font-size:12.5px; letter-spacing:0.14em; text-transform:uppercase;
    color:var(--cyan); display:flex; align-items:center; gap:10px; margin-bottom:22px;
  }
  .eyebrow .dot{
    width:7px; height:7px; border-radius:50%; background:var(--cyan);
    box-shadow:0 0 0 0 rgba(63,224,208,0.6);
    animation:pulseDot 2s ease-out infinite;
  }
  @keyframes pulseDot{
    0%{ box-shadow:0 0 0 0 rgba(63,224,208,0.55); }
    70%{ box-shadow:0 0 0 9px rgba(63,224,208,0); }
    100%{ box-shadow:0 0 0 0 rgba(63,224,208,0); }
  }
  h1.title{
    font-family:'Space Grotesk', sans-serif;
    font-size:clamp(2.4rem, 5.5vw, 4rem);
    font-weight:700; line-height:1.05; margin:0 0 22px;
    letter-spacing:-0.01em;
    border-right:3px solid var(--cyan);
    display:inline-block;
    white-space:nowrap;
    overflow:hidden;
    animation:typeIn 1.6s steps(28,end) forwards, caretBlink 0.8s step-end infinite;
    max-width:100%;
  }
  @keyframes typeIn{ from{ width:0; } to{ width:100%; } }
  @keyframes caretBlink{ 50%{ border-color:transparent; } }
  p.intro{ font-size:1.08rem; color:var(--muted); max-width:640px; opacity:0; animation:fadeUp 0.8s ease forwards 1.7s; }
  @keyframes fadeUp{ from{ opacity:0; transform:translateY(14px); } to{ opacity:1; transform:translateY(0); } }

  /* timeline */
  .timeline{ position:relative; padding:20px 0 60px; }
  .timeline::before{
    content:''; position:absolute; left:23px; top:8px; bottom:8px; width:2px;
    background:linear-gradient(180deg, var(--cyan), var(--panel-border) 85%);
    opacity:0.5;
  }
  .signal{
    position:absolute; left:19px; width:10px; height:10px; border-radius:50%;
    background:var(--cyan); box-shadow:0 0 14px 3px rgba(63,224,208,0.7);
    animation:travel 5s linear infinite;
  }
  @keyframes travel{ 0%{ top:0%; opacity:0; } 5%{ opacity:1; } 95%{ opacity:1; } 100%{ top:97%; opacity:0; } }

  .card-row{ display:flex; gap:24px; margin-bottom:44px; position:relative; }
  .node{
    flex:0 0 48px; height:48px; border-radius:50%;
    background:var(--panel); border:1px solid var(--panel-border);
    display:flex; align-items:center; justify-content:center;
    font-family:'IBM Plex Mono', monospace; font-size:10px; color:var(--cyan);
    position:relative; z-index:2; margin-top:4px;
  }

  .card{
    flex:1; min-width:0;
    background:var(--panel); border:1px solid var(--panel-border); border-radius:var(--radius);
    padding:26px; position:relative; overflow:hidden;
    opacity:0; transform:translateY(28px);
    transition:opacity 0.7s ease, transform 0.7s ease;
  }
  .card.is-visible{ opacity:1; transform:translateY(0); }
  .card::after{
    content:''; position:absolute; left:0; right:0; top:-100%; height:100%;
    background:linear-gradient(180deg, transparent, rgba(63,224,208,0.18), transparent);
    transition:top 1.1s ease;
    pointer-events:none;
  }
  .card.is-visible::after{ top:120%; }

  .card-media{
    width:100%; aspect-ratio:4/3; border-radius:10px; overflow:hidden;
    background:#0d1119; border:1px solid var(--panel-border);
    margin-bottom:18px; display:flex; align-items:center; justify-content:center;
  }
  .card-media img{ width:100%; height:100%; object-fit:contain; padding:14px; }
  .card-media.no-image{ font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--muted); }

  h3.card-title{ font-family:'Space Grotesk', sans-serif; font-size:1.28rem; font-weight:600; margin:0 0 14px; }

  .meta-row{ display:flex; flex-wrap:wrap; align-items:center; gap:18px; margin-bottom:16px; }
  .price{ font-family:'IBM Plex Mono', monospace; font-size:1.05rem; color:var(--amber); }

  .meter{ display:flex; align-items:center; gap:8px; }
  .segments{ display:flex; gap:3px; }
  .segments span{ width:14px; height:6px; border-radius:2px; background:var(--panel-border); }
  .segments span.filled{ background:var(--cyan); }
  .rating-label{ font-family:'IBM Plex Mono', monospace; font-size:11px; color:var(--muted); }

  ul.specs{ list-style:none; padding:0; margin:0 0 22px; display:grid; gap:8px; }
  ul.specs li{ font-size:0.92rem; color:var(--muted); padding-left:16px; position:relative; }
  ul.specs li::before{ content:''; position:absolute; left:0; top:8px; width:6px; height:6px; background:var(--cyan); opacity:0.7; }

  .cta{
