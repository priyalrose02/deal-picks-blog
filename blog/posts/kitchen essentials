  footer{ padding:40px 0 80px; color:var(--muted); font-size:0.85rem; border-top:1px solid var(--panel-border); }
  footer .gen{ font-family:'IBM Plex Mono', monospace; font-size:11px; letter-spacing:0.05em; }

  @media (max-width:640px){
